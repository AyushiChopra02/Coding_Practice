https://leetcode.com/problems/minimum-moves-to-clean-the-classroom/description/?envType=daily-question&envId=2026-09-01

class Solution {
    public int minMoves(String[] classroom, int energy) {
        int m = classroom.length;
        int n = classroom[0].length();

        int sr = -1, sc = -1;
        int cnt = 0;

        int[][] id = new int[m][n];
        for(int[] row : id) Arrays.fill(row, -1);

        for(int i = 0; i < m; i++){
            for(int j = 0; j < n; j++){
                if(classroom[i].charAt(j) == 'S'){
                    sr = i;
                    sc = j;
                }
                if(classroom[i].charAt(j) == 'L'){
                    id[i][j] = cnt++;
                }
            }
        }

        int masks = 1 << cnt;
        int fullMask = masks - 1;

        
        int[][][] best = new int[m][n][masks];
        for(int[][] layer : best)
            for(int[] row : layer)
                Arrays.fill(row, -1);

        class State {
            int r, c, mask, en, dist;

            State(int r, int c, int mask, int en, int dist){
                this.r = r;
                this.c = c;
                this.mask = mask;
                this.en = en;
                this.dist = dist;
            }
        }

        Queue<State> q = new LinkedList<>();

        q.add(new State(sr, sc, 0, energy, 0));
        best[sr][sc][0] = energy;

        int[] dr = {-1, 1, 0, 0};
        int[] dc = {0, 0, -1, 1};

        while(!q.isEmpty()){
            State cur = q.poll();
            int r = cur.r;
            int c = cur.c;
            int mask = cur.mask;
            int en = cur.en;
            int dist = cur.dist;
            if(mask == fullMask){
                return dist;
            }

            if(en == 0){
                continue;
            }

            for(int d = 0; d < 4; d++){
                int nr = r + dr[d];
                int nc = c + dc[d];

                if(nr < 0 || nr >= m || nc < 0 || nc >= n){
                    continue;
                }

                if(classroom[nr].charAt(nc) == 'X'){
                    continue;
                }

                int newEn = en - 1;
                int newMask = mask;

             
                if(classroom[nr].charAt(nc) == 'L'){
                    newMask |= (1 << id[nr][nc]);
                }

                if(classroom[nr].charAt(nc) == 'R'){
                    newEn = energy;
                }

           
                if(best[nr][nc][newMask] >= newEn){
                    continue;
                }

                best[nr][nc][newMask] = newEn;

                q.add(new State(nr, nc, newMask, newEn, dist + 1));
            }
        }

        return -1;
    }
}
